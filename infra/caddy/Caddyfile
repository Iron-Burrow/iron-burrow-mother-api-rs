{$CADDY_API_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'"
	}

	@api {
		path /v1/* /health /openapi.json
	}
	handle @api {
		reverse_proxy mother-api:3000
	}

	handle {
		respond "not found" 404
	}
}

{$CADDY_WEB_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'"
	}

	@web {
		path / /scan /scan/* /access /access/demo /docs /docs/* /assets/* /signup /login /logout /workspaces /workspaces/* /catalog /catalog/* /prices /prices/* /lab /lab/* /lab.json
	}
	handle @web {
		reverse_proxy mother-api:3000
	}

	handle {
		respond "not found" 404
	}
}
